# Use mock mode until Google OAuth credentials and Ads developer token are configured.
GOOGLE_CONNECTIONS_MODE=mock
GOOGLE_CONNECTIONS_MOCK_SCENARIO=normal

# Live mode uses OAuth app credentials. Keep all secrets server-side; never use NEXT_PUBLIC_*.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REFRESH_TOKEN=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:4000/auth/google/callback
# Optional legacy compatibility. Google Ads developer tokens were sunset in September 2026.
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_API_VERSION=v26

# PostgreSQL connection and first-run Super Admin bootstrap.
# Create the `adpulse` database in PostgreSQL/pgAdmin first, then set these
# credentials to a PostgreSQL role that has access to it. Example format:
# postgresql://<username>:<password>@localhost:5432/adpulse
DATABASE_URL=postgresql://postgres:password@localhost:5432/adpulse
DATABASE_SSL=false
SUPER_ADMIN_EMAIL=admin@example.com
# Set a strong one-time bootstrap password; it is required only on the first
# database initialization and must be changed at the first Super Admin login.
SUPER_ADMIN_INITIAL_PASSWORD=REPLACE_WITH_A_STRONG_ONE_TIME_PASSWORD
# Generate a unique secret of at least 32 characters for every deployment.
AUTH_TOKEN_SECRET=REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS

# Bind the API to loopback for local development.
API_HOST=127.0.0.1
API_PORT=4000
WEB_ORIGIN=http://localhost:3000
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000
