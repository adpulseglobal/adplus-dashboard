{
  "name": "adpulse-dashboard",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "dev:api": "node -r dotenv/config node_modules/@nestjs/cli/bin/nest.js start --watch",
    "build": "next build",
    "start": "next start",
    "test:contracts": "node --test packages/contracts/test/dashboard-filters.test.cjs apps/api/test/google-ads-report.test.cjs apps/api/test/ga4-report.test.cjs",
    "start:api": "node -r dotenv/config apps/api/dist/apps/api/src/main.js",
    "db:migrate": "node -r dotenv/config apps/api/scripts/migrate.cjs",
    "build:api": "nest build",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@nestjs/common": "^11.0.0",
    "@nestjs/core": "^11.0.0",
    "@nestjs/platform-express": "^11.0.0",
    "dotenv": "^16.4.7",
    "helmet": "^8.0.0",
    "lucide-react": "^0.468.0",
    "next": "^15.1.0",
    "pg": "^8.23.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@types/express": "^5.0.0",
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "typescript": "^5.7.2"
  }
}
